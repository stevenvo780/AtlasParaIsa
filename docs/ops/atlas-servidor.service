# Unidad systemd de USUARIO para el servidor público de Una Carta Para Isa (propuesta T043, 2026-09-21).
# Motivo: la sesión tmux «atlas» no sobrevive a un reinicio de la torre; el 20–21 de septiembre de 2026
# hubo tres reinicios y el servidor estuvo dos días caído. Con esta unidad arranca solo y se reinicia si muere.
#
# Instalación (la hace Steven; no toca ~/.local/bin/atlas-servidor*):
#   Crear primero ~/.config/atlas-para-isa/runtime.env con CARTA_DATA_DIR absoluto
#   y DEST para los respaldos de esa versión; no contiene contraseñas.
#   mkdir -p ~/.config/systemd/user && cp docs/ops/atlas-servidor.service ~/.config/systemd/user/
#   systemctl --user daemon-reload && systemctl --user enable --now atlas-servidor.service
#   loginctl enable-linger stev        # para que arranque sin sesión abierta
# Convivencia con tmux: si la unidad está activa, NO lanzar también el wrapper en tmux (dos procesos
# pelearían por el puerto 3000 y por data/world.sqlite). Para publicar una versión nueva:
#   bash scripts/deploy-check.sh <sha> && systemctl --user start atlas-respaldo.service
# Solo con ese gate verde y respaldo verificado, detener antes de compilar en el árbol público:
#   systemctl --user stop atlas-servidor.service && npm run build && systemctl --user start atlas-servidor.service
# Log: journalctl --user -u atlas-servidor -f
[Unit]
Description=Una Carta Para Isa — servidor público (atlas.humanizar.tech)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=%h/.local/bin/atlas-servidor
WorkingDirectory=/datos/workspaces/personal/AtlasParaIsa
Restart=always
RestartSec=5
# El mundo se guarda por la cadencia configurada y al confirmar gestos; dar tiempo al cierre ordenado.
TimeoutStopSec=60
KillSignal=SIGINT
Environment=NODE_ENV=production
# Configuración operativa sin credenciales; permite separar los mundos publicados.
# El respaldo carga el mismo archivo para copiar el mundo realmente servido.
EnvironmentFile=%h/.config/atlas-para-isa/runtime.env

[Install]
WantedBy=default.target
