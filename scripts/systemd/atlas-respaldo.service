# Unidad systemd de USUARIO: respaldo del mundo publicado con scripts/respaldo.sh (VACUUM INTO,
# quick_check y gzip), disparada cada hora por atlas-respaldo.timer. Habilitadas desde el 2026-09-22.
# Las instaladas en ~/.config/systemd/user son COPIAS de estos ficheros, no enlaces; solo se
# actualizan dentro del procedimiento de publicación de CLAUDE.md.
#
# Instalación:
#   mkdir -p ~/.config/systemd/user
#   cp scripts/systemd/atlas-respaldo.service scripts/systemd/atlas-respaldo.timer ~/.config/systemd/user/
#   systemctl --user daemon-reload
#   systemctl --user enable --now atlas-respaldo.timer
# Antes de publicar, un respaldo a mano: systemctl --user start atlas-respaldo.service, y verificar la copia.
#
# Verificación: systemctl --user status atlas-respaldo.timer
#               journalctl --user -u atlas-respaldo.service -n 20

[Unit]
Description=Respaldo horario del mundo de Isa (Una Carta Para Isa, T022)
Documentation=file:///datos/workspaces/personal/AtlasParaIsa/specs/001-mundo-solido-masivo/tasks.md
After=network.target

[Service]
Type=oneshot
WorkingDirectory=/datos/workspaces/personal/AtlasParaIsa
ExecStart=/datos/workspaces/personal/AtlasParaIsa/scripts/respaldo.sh
# Compartir CARTA_DATA_DIR con el servicio evita respaldar una versión archivada.
EnvironmentFile=%h/.config/atlas-para-isa/runtime.env
# CARTA_DATA_DIR absoluto y DEST se fijan en runtime.env antes de activar la unidad.
# Si falta el archivo, systemd falla: no respalda silenciosamente una versión vieja.
# Para una configuración explícita adicional, añadir aquí:
#   Environment=DB=/ruta/al/mundo.sqlite
#   Environment=DEST=/ruta/de/copias
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
