# Timer horario de atlas-respaldo.service, habilitado desde el 2026-09-22 (la instalada en
# ~/.config/systemd/user es una copia). Instalación y verificación: ver atlas-respaldo.service.

[Unit]
Description=Timer horario del respaldo del mundo de Isa (T022)

[Timer]
OnCalendar=hourly
Persistent=true
RandomizedDelaySec=120

[Install]
WantedBy=timers.target
