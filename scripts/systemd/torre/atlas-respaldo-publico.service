[Unit]
Description=Respaldo horario del mundo público V23 (torre)
ConditionPathIsMountPoint=/mnt/Data2

[Service]
Type=oneshot
Environment=RETENCION=24 RESPALDO_METODO=backup
EnvironmentFile=%h/.config/atlas-para-isa/publicacion-v23.env
MemoryHigh=3G
IOSchedulingClass=idle
Nice=15
ExecStart=/usr/bin/bash -c 'exec /usr/bin/bash "$$CARTA_RELEASE_DIR/scripts/respaldo.sh"'
